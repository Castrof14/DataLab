# DataLab · environment variables (NAMES ONLY — never commit real values).
# Copy to supabase/functions/.env for `supabase functions serve`, or set them with
# `supabase secrets set NAME=value` for the deployed Edge Functions.

# --- Provided automatically by Supabase to every Edge Function (do not set by hand in production) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_DB_URL=

# --- Set by you (supabase secrets set) ---
# Comma-separated origins allowed to call the Edge Functions (CORS), e.g. your site + local dev
# Must include the Vercel address, or every save/load from the published site fails as a "network error".
# "*" matches one label (for preview deploys), e.g.:
#   https://datalab.vercel.app,https://datalab-*-castrof14s-projects.vercel.app,http://localhost:5500
ALLOWED_ORIGINS=

# --- Browser (public, NOT a secret) ---
# Goes into assets/js/supabase/config.js, never into this file's secret section:
#   supabaseUrl            -> the project URL
#   supabasePublishableKey -> the publishable (anon) key
# The service_role / secret key is NEVER needed by this project and must never reach the browser.

# --- Spotify (public, NOT a secret) ---
# The site has no build step, so the browser never reads .env: the Client ID goes into
# assets/js/supabase/config.js as  spotifyClientId: '<32 hex chars>'.
# PKCE needs no client secret: never put SPOTIFY_CLIENT_SECRET anywhere in this project.

# --- YouTube Music / YTMDesktop (nothing to put here) ---
# The token is created by the YTMDesktop app on each player's computer when they approve the 4-digit code,
# and it lives only in that player's browser. No YTMDesktop token goes in this file, in config.js or on a server.
# config.js only turns the button on:  ytmDesktopEnabled: true

# --- Agent Gateway (AI for the crew) ---
# It has its own settings file: agents/.env.example (Supabase URL + anon key, ALLOWED_ORIGINS, model allow-list,
# provider API keys). Provider keys live ONLY there, on the gateway's server — never in config.js or the browser.
