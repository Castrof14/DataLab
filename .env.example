# DataLab · environment variables (NAMES ONLY — never commit real values).
# Copy to supabase/functions/.env for `supabase functions serve`, or set them with
# `supabase secrets set NAME=value` for the deployed Edge Functions.

# --- Provided automatically by Supabase to every Edge Function (do not set by hand in production) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_DB_URL=

# --- Set by you (supabase secrets set) ---
# Comma-separated origins allowed to call the Edge Functions (CORS), e.g. your site + local dev
ALLOWED_ORIGINS=

# --- Browser (public, NOT a secret) ---
# Goes into assets/js/supabase/config.js, never into this file's secret section:
#   supabaseUrl            -> the project URL
#   supabasePublishableKey -> the publishable (anon) key
# The service_role / secret key is NEVER needed by this project and must never reach the browser.
