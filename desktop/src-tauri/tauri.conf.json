{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DataLab",
  "version": "0.9.0",
  "identifier": "app.datalab.desktop",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run stage",
    "beforeBuildCommand": "npm run stage"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "SimulationGame",
    "shortDescription": "Opere um datacenter. Um rack de cada vez.",
    "copyright": "DataLab",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
