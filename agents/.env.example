# DataLab · Agent Gateway — copy to agents/.env (never commit the real file).

# --- where it listens (behind a TLS reverse proxy in production) ---
HOST=127.0.0.1
PORT=8787
# AGENT_DATA_DIR=./data          # workspaces, history, OpenCode's own home

# --- who is calling: Supabase Auth (PUBLIC values, the same as assets/js/supabase/config.js) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- CORS: the sites allowed to call the gateway ("*" matches one DNS label) ---
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# --- models the players may pick ("provider/model", "*" wildcards) ---
# OpenCode's free models need no key. Add paid ones only with a key below, e.g.
#   ALLOWED_MODELS=opencode/*,anthropic/claude-sonnet-*
ALLOWED_MODELS=opencode/*
DEFAULT_MODEL=opencode/big-pickle

# --- provider keys: stay on this server, never reach the browser ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# OPENCODE_API_KEY=

# --- server ceilings (a player's own limits are clamped to these) ---
CAP_DAILY_TASKS=30
CAP_CONCURRENT=2
CAP_MAX_MINUTES=15
CAP_MAX_STEPS=40
CAP_MAX_TOKENS=1000000
CAP_DAILY_COST_USD=2
CAP_PROMPT_CHARS=4000
MAX_PARALLEL_TASKS=4
APPROVAL_TIMEOUT_SEC=120

# --- sandbox ---
# 1 ONLY inside the hardened container (Dockerfile sets it): unlocks "run scripts" (node, python, npm run).
SANDBOX_TRUSTED=0
# web tools (webfetch / websearch) may be offered to players
ALLOW_WEB=0
# OPENCODE_BIN=opencode

# tests only — NEVER in production
# AGENT_MOCK=1
